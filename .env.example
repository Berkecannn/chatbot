# setup.bat / init_env.py creates these locally; never commit real values.
FLASK_SECRET_KEY=
JWT_SECRET_KEY=
ENCRYPTION_KEY=
FLASK_DEBUG=False
# Set true behind production HTTPS; keep false for local HTTP.
COOKIE_SECURE=false
# Optional: only the deployment owner may approve an internal mail host.
ALLOW_PRIVATE_MAIL_HOSTS=
